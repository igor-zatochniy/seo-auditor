FROM chromedp/headless-shell@sha256:f76fce2964611eb1e25b90d906727884db12a8918a6d85a0df2619a9ef845c7c
RUN apt-get update && apt-get install -y --no-install-recommends \
      libbrotli1=1.1.0-2+deb13u1 \
      libexpat1=2.9.0-1~deb13u1 \
      libpcre2-8-0=10.46-1~deb13u3 \
      libssl3t64=3.5.7-1~deb13u3 \
      openssl-provider-legacy=3.5.7-1~deb13u3 \
    && rm -rf /var/lib/apt/lists/*
COPY render-browser.sh /usr/local/bin/render-browser.sh
ENV HOME=/tmp
USER 10001:10001
ENTRYPOINT ["/bin/bash", "/usr/local/bin/render-browser.sh"]
CMD ["--user-data-dir=/tmp/chromium", "--proxy-server=http://127.0.0.1:9", "--proxy-bypass-list=<-loopback>", "--host-resolver-rules=MAP * ~NOTFOUND", "--force-webrtc-ip-handling-policy=disable_non_proxied_udp", "--disable-quic", "--disable-background-networking", "--disable-extensions", "--disable-sync", "--no-first-run"]
