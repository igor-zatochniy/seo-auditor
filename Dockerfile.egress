FROM alpine:3.24@sha256:f59abe656b692d901e184be3445e084786602108599d2a51d229c0f5a48c71bf

RUN apk add --no-cache --upgrade iptables musl-utils libcrypto3=3.5.9-r0 libssl3=3.5.9-r0
COPY --chmod=755 deploy/egress-guard.sh /usr/local/bin/egress-guard
ENTRYPOINT ["/bin/sh", "/usr/local/bin/egress-guard"]
